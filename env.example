# Copy this file to .env and fill in real values before running the server.

# Port the server listens on (most hosts set this automatically — leave as is)
PORT=3000

# Secret key you invent yourself. Used to protect the /admin dashboard and admin API.
# Pick something long and random, e.g. a 20+ character string.
ADMIN_KEY=change-this-to-a-long-random-secret

# The phone number(s) customers are told to send manual bKash/Nagad payment to.
BKASH_NUMBER=01XXXXXXXXX
NAGAD_NUMBER=01XXXXXXXXX
